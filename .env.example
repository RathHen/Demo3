# Webull Dashboard — non-sensitive config
#
# WEBULL_APP_KEY, WEBULL_APP_SECRET, and DASHBOARD_PASSWORD are stored in
# Windows Credential Manager (encrypted). Run store_credentials.bat to set them.
# Only put non-secret values here.

# Region: "us" for US market, "hk" for HK market
WEBULL_REGION_ID=us

# Environment: "prod" for live trading, "uat" for sandbox/test.
# MUST be "prod" for your real Webull account — "uat" will reject live credentials.
WEBULL_ENVIRONMENT=prod

# Your account ID. Run the app, open the Account Info tab to find it,
# then paste it here.
WEBULL_ACCOUNT_ID=

# Optional: override the default API endpoint
# WEBULL_API_ENDPOINT=

# ── Schwab ──────────────────────────────────────────────────────────────────
# SCHWAB_APP_KEY and SCHWAB_APP_SECRET are stored in Windows Credential Manager.
# This URL must match exactly what is registered in your Schwab developer app.
SCHWAB_CALLBACK_URL=https://127.0.0.1

# ── Server ──────────────────────────────────────────────────────────────────
# Port the app listens on (the tunnel points here).
PORT=5000
# Never set to true when exposed to the internet.
FLASK_DEBUG=false
