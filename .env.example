# Webull OpenAPI credentials
# Get your App Key and App Secret from the Webull website:
#   US: https://www.webull.com  →  OpenAPI Management
#   HK: https://www.webull.hk  →  OpenAPI Management
#
# After copying this file to .env, fill in your values.

WEBULL_APP_KEY=your_app_key_here
WEBULL_APP_SECRET=your_app_secret_here

# Region: "us" for US market, "hk" for HK market
WEBULL_REGION_ID=us

# Optional: override the default API endpoint
# WEBULL_API_ENDPOINT=

# Your account ID (run the app once and use the Accounts API to find it,
# or leave blank to select from the dropdown after loading the account list)
WEBULL_ACCOUNT_ID=

# ── Dashboard login ─────────────────────────────────────────────────────────
# REQUIRED before exposing the app through a tunnel or any public URL.
# Your browser will prompt for these when you open the dashboard.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change_me_to_a_strong_password

# ── Server ──────────────────────────────────────────────────────────────────
# Port the app listens on (the tunnel points here).
PORT=5000
# Never set to true when exposed to the internet.
FLASK_DEBUG=false
